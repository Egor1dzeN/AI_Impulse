# Copy to .env (git-ignored) and fill in. backend.sh/dev.sh source this
# file automatically before starting uvicorn.

# GigaChat — when set, the agent uses GigaChat instead of the local
# Qwen3-4B (see app/agent_graph.py::_build_llm). Leave unset to keep
# developing against the local model.
GIGA_CHAT_IDE=
# GIGA_CHAT_EMBEDDING is actually a cloud.ru foundation-models API key, not
# a Sberbank GigaChat one (naming kept as originally set). It switches BOTH
# the memory embedder and reranker to cloud.ru's hosted
# Qwen/Qwen3-Embedding-0.6B and Qwen/Qwen3-Reranker-0.6B — the exact same
# checkpoints the local versions use, so no FAISS reindex is needed and
# retrieval quality/thresholds carry over unchanged. Leave unset to keep
# both running locally. See memory/cloud_ru_embedder.py and
# memory/cloud_ru_reranker.py.
# Same key also powers voice input (app/transcription.py, POST
# /api/transcribe) via cloud.ru's Whisper endpoint — response_format=text
# was observed to still return a JSON {"text":...,"usage":...} body rather
# than bare text, so transcribe_audio() unwraps it.
GIGA_CHAT_EMBEDDING=
# CLOUD_RU_BASE_URL=https://foundation-models.api.cloud.ru/v1
# CLOUD_RU_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# CLOUD_RU_RERANK_BASE_URL=https://foundation-models.api.cloud.ru
# CLOUD_RU_RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
# CLOUD_RU_WHISPER_MODEL=openai/whisper-large-v3
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GIGACHAT_MODEL=GigaChat-3-Ultra
# GIGACHAT_BASE_URL=https://api.giga.chat/v1
# GIGACHAT_VERIFY_SSL=0

# Same GIGA_CHAT_IDE key also switches the memory pipeline's grammar
# normalizer AND the extraction/coreference/relation-extraction/dreaming/
# validation LLM (memory/gigachat_text_model.py, replaces the shared
# Qwen3-4B from memory/model_registry.py::get_qwen()) to the GigaChat chat
# API — confirmed working with GigaChat-2, which draws from the huge free
# "GigaChat"/Lite quota bucket rather than the paid tiers.
# Known quirk: GigaChat-2 sometimes ignores "confidence: 0-1" instructions
# and always returns 0.0, and occasionally emits multiple {...} objects
# instead of a JSON array (gigachat_text_model.py repairs the latter by
# wrapping in [] when the raw response fails to parse). Worth re-checking
# memory quality after a while; bump to GigaChat-2-Pro/Max if it matters.
# GIGACHAT_LITE_MODEL=GigaChat-2

# The embedder is a SEPARATE opt-in (GIGA_CHAT_IDE alone is not enough):
# on the GIGACHAT_API_PERS tariff, /v1/embeddings returned 402 Payment
# Required for every model (Embeddings, Embeddings-2, EmbeddingsGigaR,
# GigaEmbeddings-3B-2025-09) — client.get_balance() only shows quota for
# chat models, none for embeddings. Leave GIGACHAT_USE_EMBEDDINGS unset
# (stays on local Qwen3-Embedding-0.6B) until embeddings billing is set up
# on the account, then set it to 1.
# GIGACHAT_USE_EMBEDDINGS=1
# GIGACHAT_EMBEDDINGS_MODEL=Embeddings-2

# AUTH_SECRET_KEY=
# INTERVALS_ICU_API_KEY=
# MAPBOX_TOKEN=

# Google Calendar (per-user reminders/events via create_calendar_event —
# see app/google_calendar.py) AND Gmail (read/draft via list_emails/
# get_email/draft_email — see app/gmail.py). Both share the same OAuth
# client as Google Sign-In (GOOGLE_CLIENT_ID, hardcoded default in
# app/auth.py) via app/google_oauth.py — that Sign-In flow never needed a
# client_secret before now, so add one for that same client in Cloud
# Console, enable the Calendar API AND Gmail API on the project, and add
# BOTH redirect URIs below as Authorized redirect URIs on it.
GOOGLE_CLIENT_SECRET=
# GOOGLE_CALENDAR_REDIRECT_URI=http://127.0.0.1:8001/api/google-calendar/callback
# GMAIL_REDIRECT_URI=http://127.0.0.1:8001/api/gmail/callback
# FRONTEND_URL=http://localhost:5173

# Gmail note: the agent can only READ mail and prepare a draft
# (draft_email) — there is deliberately NO send tool exposed to it at all.
# Actually sending only happens via POST /api/gmail/send, called exclusively
# by the "Send" button on the draft card in the chat UI (see Chat.jsx's
# EmailDraftEmbed) — a real UI confirmation gate, not just a system-prompt
# instruction the model could misfire on. sent_email_drafts (db.py) also
# guards against a stale draft card re-sending after a page refresh.

# Telegram bot token (app/telegram_bot_client.py) — from @BotFather.
TELEGRAM_BOT_TOKEN=
